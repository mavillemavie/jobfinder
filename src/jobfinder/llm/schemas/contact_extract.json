{
  "type": "object",
  "additionalProperties": false,
  "required": ["people", "emails", "phones", "notes"],
  "properties": {
    "people": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["full_name", "title", "role_hint", "email", "phone"],
        "properties": {
          "full_name": {"type": "string", "maxLength": 120},
          "title": {"type": "string", "maxLength": 150},
          "role_hint": {"type": "string", "enum": ["hiring_manager", "recruiter", "other", "unknown"]},
          "email": {"type": "string", "maxLength": 200},
          "phone": {"type": "string", "maxLength": 60}
        }
      }
    },
    "emails": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 200}},
    "phones": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 60}},
    "notes": {"type": "string", "maxLength": 300}
  }
}
