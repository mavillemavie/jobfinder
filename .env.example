# LLM: claude_code (default, uses your Claude Code login) | anthropic | lmstudio | fake
LLM_PROVIDER=claude_code
ANTHROPIC_API_KEY=            # only for LLM_PROVIDER=anthropic
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_MODEL=

# Job sources (all free tiers) — see docs/SETUP-KEYS.md
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
JOOBLE_API_KEY=
RAPIDAPI_KEY=                 # JSearch + Fantastic Jobs (LinkedIn Job Search API, Active Jobs DB)

# Contact discovery
APOLLO_API_KEY=
HUNTER_API_KEY=
SERPER_API_KEY=

# Digest (Gmail SMTP with an App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
DIGEST_TO=
